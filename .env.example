# Server
PORT=3000
NODE_ENV=development

# Session
SESSION_SECRET=YOU_MUST_CHANGE_THIS

# Admin credentials (default, change after first login)
ADMIN_USERNAME=YOU_MUST_CHANGE_THIS
# Run `npm run init-db` after setting this password
# Password will be hashed automatically
ADMIN_PASSWORD=YOU_MUST_CHANGE_THIS

# Database
DB_PATH=./server/database/database.sqlite
